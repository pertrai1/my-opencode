{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "lean",
  "agent": {
    "lean": {
      "description": "Lean default agent with a smaller first-call context. Uses local code tools by default and keeps heavier tools opt-in via the build and plan agents.",
      "model": "openai/gpt-5.4",
      "permission": {
        "lsp": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": "allow",
        "question": "deny",
        "task": "deny",
        "todowrite": "deny",
        "mdn_search": "deny",
        "mdn_get-doc": "deny",
        "mdn_get-compat": "deny",
        "llm-core_get_active_instructions": "deny",
        "llm-core_lint_file": "deny",
        "agentmemory_memory_audit": "deny",
        "agentmemory_memory_export": "deny",
        "agentmemory_memory_governance_delete": "deny",
        "agentmemory_memory_recall": "deny",
        "agentmemory_memory_save": "deny",
        "agentmemory_memory_sessions": "deny",
        "agentmemory_memory_smart_search": "deny"
      }
    },
    "build": {
      "model": "openai/gpt-5.4"
    },
    "plan": {
      "model": "openai/gpt-5.6-terra"
    }
  },
  "lsp": true,
  "instructions": [
    "~/.claude/CLAUDE.md",
    "AGENTS.md",
    "~/.config/opencode/docs/agents/style-guide.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "references": {
    "workflow": {
      "path": "./docs/agents",
      "description": "Issue tracker, triage labels, agent workflow docs, and style guidance"
    },
    "reviewers": {
      "path": "./agents",
      "description": "Custom review and implementation agents plus reviewer prompts"
    }
  },
  "autoupdate": "notify",
  "enabled_providers": ["openai", "ollama"],
  "permission": {
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "edit": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "unlink *": "deny",
      "git clean *": "deny",
      "rtk git clean *": "deny",
      "git reset --hard *": "deny",
      "rtk git reset --hard *": "deny",
      "git restore *": "deny",
      "rtk git restore *": "deny",
      "git checkout -- *": "deny",
      "rtk git checkout -- *": "deny",
      "git push --force *": "deny",
      "rtk git push --force *": "deny",
      "git push --force-with-lease *": "deny",
      "rtk git push --force-with-lease *": "deny",
      "git push * --force": "deny",
      "rtk git push * --force": "deny",
      "git push * --force-with-lease": "deny",
      "rtk git push * --force-with-lease": "deny",
      "git push origin --delete *": "deny",
      "rtk git push origin --delete *": "deny",
      "git push * :*": "deny",
      "rtk git push * :*": "deny",
      "git tag -d *": "deny",
      "rtk git tag -d *": "deny",
      "git rebase *": "deny",
      "rtk git rebase *": "deny"
    }
  },
  "plugin": [
    "./plugins/crg-plugin.ts",
    "./plugins/herdr-agent-state.js",
    "./plugins/rtk.ts",
    "./plugins/sonarqube-mcp.ts",
    [
      "./plugins/safety.ts",
      {
        "truncation": {
          "maxLength": 30000,
          "headLength": 20000,
          "tailLength": 10000,
          "tempDir": "~/.opencode/tmp",
          "retentionHours": 24,
          "maxTempDirSizeMB": 100
        },
        "doomLoop": {
          "enabled": true,
          "bufferSize": 5,
          "maxRepetitions": 3,
          "exemptTools": ["read", "grep", "glob"]
        }
      }
    ],
    "@openchamber/opencode-claude@0.14.0"
  ],
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 600000,
        "timeout": 600000,
        "chunkTimeout": 600000
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder-30b-64k:latest": {
          "name": "Qwen-3-Coder-30B-64K"
        }
      }
    }
  },
  "mcp": {
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": true
    },
    "llm-core": {
      "type": "local",
      "command": ["npx", "-y", "eslint-plugin-llm-core-mcp"],
      "enabled": true
    },
    "sonarqube": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "--init",
        "--pull=always",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_URL",
        "-e",
        "SONARQUBE_PROJECT_KEY",
        "sonarsource/sonarqube-mcp"
      ],
      "enabled": true
    }
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "formatter": true
}
