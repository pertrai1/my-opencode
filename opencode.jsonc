{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-sol",
  "default_agent": "build",
  "agents": {
    "build": {
      "model": "openai/gpt-6-sol"
    },
    "plan": {
      "model": "openai/gpt-6-astra"
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "headerTimeout": 600000,
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "gpt-6-astra": {
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder-30b-64k:latest": {
          "name": "Qwen-3-Coder-30B-64K",
          "modelID": "qwen3-coder-30b-64k:latest"
        }
      }
    }
  },
  "lsp": true,
  "references": {
    "workflow": {
      "path": "./docs/agents",
      "description": "Issue tracking, triage labels, agent workflow docs, and style guidance"
    },
    "reviewers": {
      "path": "./agents",
      "description": "Specialist reviewers and implementation roles"
    }
  },
  "update": "notify",
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git restore *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "mdn": {
        "type": "remote",
        "url": "https://mcp.mdn.mozilla.net/"
      },
      "llm-core": {
        "type": "local",
        "command": ["npx", "-y", "eslint-plugin-llm-core-mcp"]
      },
      "sonarqube": {
        "type": "local",
        "command": [
          "docker", "run", "-i", "--rm", "--init", "--pull=always",
          "-e", "SONARQUBE_TOKEN",
          "-e", "SONARQUBE_URL",
          "-e", "SONARQUBE_PROJECT_KEY",
          "sonarsource/sonarqube-mcp"
        ]
      }
    }
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "formatter": true
}
