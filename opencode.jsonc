{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-sol",
  "providers": {
    "openai": {
      "settings": {
        "headerTimeout": 600000,
        "timeout": 600000,
        "chunkTimeout": 600000,
      },
      "models": {
        "gpt-6-astra": {
          "settings": {
            "reasoningEffort": "high",
          },
        },
      },
    },
  },
  "default_agent": "lean",
  // Optional Jev routing is disabled by default; enable with OPENCODE_JEV_ROUTING=1.
  "agents": {
    "lean": {
      "description": "Lean default agent with a smaller first-call context. Uses local code tools by default and keeps heavier tools opt-in via the build and plan agents.",
      "model": "openai/gpt-6-luna#high",
      "mode": "primary",
      "permissions": [
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "mdn_search",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "mdn_get_doc",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "mdn_get_compat",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "llm_core_get_active_instructions",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "llm_core_lint_file",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "agentmemory_memory_audit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "agentmemory_memory_export",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "agentmemory_memory_governance_delete",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "agentmemory_memory_recall",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "agentmemory_memory_save",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "agentmemory_memory_sessions",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "agentmemory_memory_smart_search",
          "resource": "*",
          "effect": "deny",
        },
      ],
    },
    "build": {
      "model": "openai/gpt-6-sol",
    },
    "plan": {
      "model": "openai/gpt-6-astra",
    },
  },
  "lsp": true,
  "instructions": [
    "~/.claude/CLAUDE.md",
    "AGENTS.md",
    "~/.config/opencode/docs/agents/style-guide.md",
  ],
  "compaction": {
    "auto": true,
    "buffer": 12000,
  },
  "references": {
    "workflow": {
      "path": "./docs/agents",
      "description": "Issue tracker, triage labels, agent workflow docs, and style guidance",
    },
    "reviewers": {
      "path": "./agents",
      "description": "Custom review and implementation agents plus reviewer prompts",
    },
  },
  "autoupdate": "notify",
  "enabled_providers": ["openai", "ollama", "anthropic", "github-copilot"],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "rmdir *", "effect": "deny" },
    { "action": "shell", "resource": "unlink *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git restore *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git restore *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force-with-lease *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git push --force-with-lease *", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force", "effect": "deny" },
    { "action": "shell", "resource": "rtk git push * --force", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force-with-lease", "effect": "deny" },
    { "action": "shell", "resource": "rtk git push * --force-with-lease", "effect": "deny" },
    { "action": "shell", "resource": "git push origin --delete *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git push origin --delete *", "effect": "deny" },
    { "action": "shell", "resource": "git push * :*", "effect": "deny" },
    { "action": "shell", "resource": "rtk git push * :*", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git tag -d *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git rebase *", "effect": "deny" },
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen3-coder-30b-64k:latest": {
          "name": "Qwen-3-Coder-30B-64K",
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "mdn": {
        "type": "remote",
        "url": "https://mcp.mdn.mozilla.net/",
        "disabled": false,
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
      },
      "gitnexus": {
        "type": "local",
        "command": ["npx", "-y", "gitnexus@latest", "mcp"],
        "disabled": true,
      },
      "llm-core": {
        "type": "local",
        "command": ["npx", "-y", "eslint-plugin-llm-core-mcp@latest"],
        "environment": {
          "LLM_CORE_MCP_ENABLE_FALLBACK": "1",
        },
        "disabled": false,
      },
      "fallow": {
        "type": "local",
        "command": ["npx", "-y", "--package=fallow", "fallow-mcp"],
        "disabled": true,
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      },
      "sonarqube": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "--init",
          "--pull=always",
          "-e",
          "SONARQUBE_TOKEN",
          "-e",
          "SONARQUBE_URL",
          "-e",
          "SONARQUBE_PROJECT_KEY",
          "sonarsource/sonarqube-mcp",
        ],
        "disabled": false,
      },
      "codescene": {
        "type": "local",
        "command": ["npx", "-y", "@codescene/codehealth-mcp"],
        "environment": {
          "CS_ACCESS_TOKEN": "{env:CS_ACCESS_TOKEN}",
        },
      },
    },
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200,
  },
  "formatter": true,
}
