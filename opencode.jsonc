{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "openai/gpt-5.4",
    },
    "plan": {
      "model": "openai/gpt-5.6-terra",
    },
  },
  "lsp": true,
  "instructions": ["~/.claude/CLAUDE.md", "~/.claude/RTK.md", "AGENTS.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000,
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"],
  },
  "autoupdate": "notify",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "edit": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "unlink *": "deny",
      "git clean *": "deny",
      "rtk git clean *": "deny",
      "git reset --hard *": "deny",
      "rtk git reset --hard *": "deny",
      "git restore *": "deny",
      "rtk git restore *": "deny",
      "git checkout -- *": "deny",
      "rtk git checkout -- *": "deny",
      "git push --force *": "deny",
      "rtk git push --force *": "deny",
      "git push --force-with-lease *": "deny",
      "rtk git push --force-with-lease *": "deny",
      "git push * --force": "deny",
      "rtk git push * --force": "deny",
      "git push * --force-with-lease": "deny",
      "rtk git push * --force-with-lease": "deny",
      "git push origin --delete *": "deny",
      "rtk git push origin --delete *": "deny",
      "git push * :*": "deny",
      "rtk git push * :*": "deny",
      "git tag -d *": "deny",
      "rtk git tag -d *": "deny",
      "git rebase *": "deny",
      "rtk git rebase *": "deny",
    },
  },
  "plugin": [
    "./plugins/agentmemory-capture.ts",
    "./plugins/crg-plugin.ts",
    "./plugins/herdr-agent-state.js",
    "./plugins/rtk.ts",
    "./plugins/secret-scan.ts",
    "./plugins/safety.ts",
  ],
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 600000,
        "timeout": 600000,
        "chunkTimeout": 600000,
      },
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen3-coder-30b-64k:latest": {
          "name": "Qwen-3-Coder-30B-64K",
        },
      },
    },
  },
  "mcp": {
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": true,
    },
    "llm-core": {
      "type": "local",
      "command": ["npx", "-y", "eslint-plugin-llm-core-mcp"],
      "enabled": true,
    },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true,
    },
  },
  "safety": {
    "truncation": {
      "maxLength": 30000,
      "headLength": 20000,
      "tailLength": 10000,
      "tempDir": "~/.opencode/tmp",
      "retentionHours": 24,
      "maxTempDirSizeMB": 100,
    },
    "doomLoop": {
      "enabled": true,
      "bufferSize": 5,
      "maxRepetitions": 3,
      "exemptTools": ["read", "grep", "glob"],
    },
  },
  "formatter": true,
}
