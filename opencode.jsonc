{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "openai/gpt-5.4",
    },
    "plan": {
      "model": "openai/gpt-5.6-terra",
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "mcp": {
        "agentmemory": {
          "enabled": false
        }
      },
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "question": "allow",
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "deny",
          "ls": "allow",
          "ls *": "allow",
          "rtk ls": "allow",
          "rtk ls *": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "rtk cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "find *": "allow",
          "rtk find *": "allow",
          "rg *": "allow",
          "rtk rg *": "allow",
          "grep *": "allow",
          "rtk grep *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "rtk git status": "allow",
          "rtk git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "rtk git diff": "allow",
          "rtk git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "rtk git log": "allow",
          "rtk git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "rtk git show": "allow",
          "rtk git show *": "allow",
          "git branch": "allow",
          "git branch *": "allow",
          "rtk git branch": "allow",
          "rtk git branch *": "allow",
          "git stash list": "allow",
          "git stash list *": "allow",
          "rtk git stash list": "allow",
          "rtk git stash list *": "allow",
          "sed": "allow",
          "rtk sed": "allow",
          "awk": "allow",
          "rtk awk": "allow"
        }
      }
    },
  },
  "lsp": true,
  "instructions": ["~/.claude/CLAUDE.md", "~/.claude/RTK.md", "AGENTS.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000,
  },
  "references": {
    "workflow": {
      "path": "./docs/agents",
      "description": "Issue tracker, triage labels, and agent workflow docs"
    },
    "reviewers": {
      "path": "./agent",
      "description": "Custom review agents and review prompts"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"],
  },
  "autoupdate": "notify",
  "enabled_providers": ["openai", "ollama"],
  "permission": {
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "edit": "ask",
    "task": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "rtk ls": "allow",
      "rtk ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "rtk cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "rtk find *": "allow",
      "rg *": "allow",
      "rtk rg *": "allow",
      "grep *": "allow",
      "rtk grep *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "rtk git status": "allow",
      "rtk git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "rtk git diff": "allow",
      "rtk git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "rtk git log": "allow",
      "rtk git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "rtk git show": "allow",
      "rtk git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "rtk git branch": "allow",
      "rtk git branch *": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "rtk git stash list": "allow",
      "rtk git stash list *": "allow",
      "rm *": "deny",
      "git clean *": "deny",
      "rtk git clean *": "deny",
      "git reset --hard *": "deny",
      "rtk git reset --hard *": "deny",
      "git push *": "deny",
      "rtk git push *": "deny",
      "git rebase *": "deny",
      "rtk git rebase *": "deny",
    },
  },
  "plugin": [
    "./plugins/agentmemory-capture.ts",
    "./plugins/crg-plugin.ts",
    "./plugins/herdr-agent-state.js",
    "./plugins/rtk.ts",
    "./plugins/safety.ts",
  ],
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 600000,
        "timeout": 600000,
        "chunkTimeout": 600000,
      },
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen3-coder-30b-64k:latest": {
          "name": "Qwen-3-Coder-30B-64K",
        },
      },
    },
  },
  "mcp": {
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": true,
    },
    "llm-core": {
      "type": "local",
      "command": ["npx", "-y", "eslint-plugin-llm-core-mcp"],
      "enabled": true,
    },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true,
    },
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "formatter": true,
}
